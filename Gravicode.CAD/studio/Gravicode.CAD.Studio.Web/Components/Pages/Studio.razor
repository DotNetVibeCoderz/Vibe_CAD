@page "/studio"
@implements IDisposable
@inject StudioSession S
@inject NavigationManager Nav

<PageTitle>@S.Document.Name — Gravicode CAD Studio</PageTitle>

<div class="studio" data-view="@S.ViewMode">
    <RibbonBar OnCommand="RunAsync" />

    <BrowserPanel />

    <main class="viewport" aria-label="@S.T("Model space", "Ruang model")">
        @if (S.ViewMode != "3d")
        {
            <section class="viewport__pane viewport__pane--2d">
                <span class="pane-tag">@(S.Document.ActiveSpace is null ? S.T("TOP · MODEL", "ATAS · MODEL") : S.Engine.SpaceName(S.Document.ActiveSpace).ToUpperInvariant())</span>
                <Canvas2D @ref="_canvas" OnAppAction="RunAsync" />
                <nav class="space-bar" aria-label="@S.T("Spaces", "Ruang")">
                    <button type="button" class="@(S.Document.ActiveSpace is null ? "on" : "")" @onclick="() => S.Engine.SetSpace(null)">@S.T("MODEL", "MODEL")</button>
                    @foreach (var p in S.Document.Planes.Values)
                    {
                        <button type="button" class="plane @(S.Document.ActiveSpace == p.Key ? "on" : "")" title="@S.T("Sketch on this face", "Gambar di permukaan ini")" @onclick="() => S.Engine.SetSpace(p.Key)">@p.Name</button>
                    }
                    @foreach (var l in S.Document.Layouts.Values)
                    {
                        <button type="button" class="layout @(S.Document.ActiveSpace == l.Key ? "on" : "")" title="@($"{l.Paper} {(l.Landscape ? "landscape" : "portrait")}")" @onclick="() => S.Engine.SetSpace(l.Key)">@l.Name</button>
                    }
                    <button type="button" class="add" title="@S.T("New paper-space layout", "Layout kertas baru")" @onclick='() => RunAsync("LAYOUT New")'>+ LAYOUT</button>
                </nav>
            </section>
        }
        @if (S.ViewMode != "2d")
        {
            <section class="viewport__pane viewport__pane--3d">
                <span class="pane-tag">3D · @S.Document.Solids.Count @S.T("SOLIDS", "SOLID")</span>
                @if (S.Document.Solids.Count == 0)
                {
                    <div class="empty3d">
                        <p>@S.T("Nothing to show in 3D yet.", "Belum ada yang tampil di 3D.")</p>
                        <p class="muted">@S.T("Draw a closed shape and EXTRUDE it, or start with BOX.", "Gambar bentuk tertutup lalu EXTRUDE, atau mulai dengan BOX.")</p>
                        <button type="button" class="btn" @onclick='() => RunAsync("BOX")'>BOX</button>
                    </div>
                }
                else
                {
                    <CadViewer Model="Model3D" Height="100%" Theme="dark" ShowGrid="true" KeepViewOnUpdate="true"
                               Selectable="true" Highlighted="Highlighted3D" GizmoMode="@_gizmo" GizmoSnap="S.Engine.Settings.GridSize"
                               OnPick="OnPick3D" OnGizmo="OnGizmo3D" />
                    <div class="gizmo-bar" role="toolbar" aria-label="@S.T("3D tools", "Alat 3D")">
                        @foreach (var (mode, label, tip) in GizmoModes)
                        {
                            <button type="button" class="@(_gizmo == mode ? "on" : "")" title="@tip" @onclick="() => _gizmo = mode">@label</button>
                        }
                    </div>
                }
            </section>
        }
    </main>

    <PropertiesPanel />

    <CommandLine />
    <StatusBar />

    <InputFile id="open-file" class="visually-hidden" OnChange="OpenAsync" accept="@Accept" />
    @if (_toast is not null)
    {
        <div class="toast" role="status">@_toast</div>
    }
</div>

@code {
    private Canvas2D? _canvas;
    private CadModel? _model;
    private (StudioDocument?, int) _modelKey;
    private IReadOnlyList<StudioSolid> _bodies = [];
    private string? _gizmo = "move";

    private (string? Mode, string Label, string Tip)[] GizmoModes =>
    [
        (null, S.T("SELECT", "PILIH"), S.T("Click solids to select them (Shift adds)", "Klik solid untuk memilih (Shift menambah)")),
        ("move", S.T("MOVE", "PINDAH"), S.T("Drag an arrow to move the selection along X, Y or Z (Alt = no snap)", "Seret panah untuk memindah seleksi sepanjang X, Y atau Z (Alt = tanpa snap)")),
        ("rotate", S.T("ROTATE", "PUTAR"), S.T("Drag a ring to rotate the selection in 15° steps (Alt = free)", "Seret cincin untuk memutar seleksi per 15° (Alt = bebas)")),
        ("scale", S.T("SCALE", "SKALA"), S.T("Drag a handle outwards to scale the selection uniformly in 0.1 steps (Alt = free)", "Seret pegangan keluar untuk menskala seleksi per 0,1 (Alt = bebas)")),
    ];

    /// <summary>Viewer body indices of the selected solids.</summary>
    private int[] Highlighted3D
    {
        get
        {
            _ = Model3D;   // keeps _bodies in step with the model
            var r = new List<int>();
            for (int i = 0; i < _bodies.Count; i++) if (S.Engine.Selection.Contains(_bodies[i].Id)) r.Add(i);
            return [.. r];
        }
    }

    private void OnPick3D(CadPickEventArgs e)
    {
        Guid? id = e.BodyIndex >= 0 && e.BodyIndex < _bodies.Count ? _bodies[e.BodyIndex].Id : null;
        // "click a face" prompts (UCS Face) take the face; otherwise a click selects the solid
        if (S.Engine.CurrentPrompt?.Kind == PromptKind.Face) { if (id is { } f) S.Engine.PickFace(f, e.Point, e.Normal); }
        else S.Engine.PickObject(id, e.Additive);
    }

    private void OnGizmo3D(CadGizmoEventArgs e)
    {
        if (e.Mode == "move") S.Engine.Move3D(e.Delta);
        else if (e.Mode == "scale") S.Engine.Scale3D(e.Factor, e.Pivot);
        else S.Engine.Rotate3D(e.Axis, e.Angle, e.Pivot);
    }
    private string? _toast;
    private CancellationTokenSource? _toastCts;

    private static readonly string Accept = string.Join(",", ProjectFile.ImportExtensions.Select(e => "." + e).Append(".gcproj"));

    private CadModel Model3D
    {
        get
        {
            // rebuild only when solids change (drawing edits and selection keep the 3D scene)
            var key = (S.Document, S.Document.SolidsKey());
            if (_model is null || key != _modelKey)
            {
                _model = S.Document.ToCadModel(includeDrawing: false);
                _bodies = S.Document.ViewerSolids();
                _modelKey = key;
            }
            return _model;
        }
    }

    protected override void OnInitialized()
    {
        S.Changed += OnChanged;
        S.Engine.FileProduced += OnFileProduced;
    }

    // PLOT and other file-producing commands → browser download
    private void OnFileProduced(string name, byte[] bytes, string mime) =>
        _ = InvokeAsync(async () => { await DownloadAsync(name, bytes, mime); Toast($"{S.T("Downloaded", "Diunduh")} {name}"); });

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task RunAsync(string command)
    {
        if (!command.StartsWith("app:")) { S.Engine.Submit(command); return; }
        var action = command[4..];
        switch (action)
        {
            case "view-2d": case "view-3d": case "view-split":
                S.ViewMode = action[5..]; S.Notify(); break;
            case "new":
                Nav.NavigateTo(""); break;
            case "open":
                await JS.InvokeVoidAsync("eval", "document.getElementById('open-file').click()"); break;
            case "update":
                // the web edition is updated by whoever hosts it; point to the releases page
                await JS.InvokeVoidAsync("open", "https://github.com/DotNetVibeCoderz/Vibe_CAD/releases", "_blank");
                break;
            case "save":
                await DownloadAsync(FileBase() + ".gcproj", ProjectFile.Save(S.Document), "application/octet-stream");
                S.Document.IsDirty = false; S.Notify();
                Toast(S.T("Project saved to your downloads.", "Proyek disimpan ke folder unduhan.")); break;
            default:
                if (action.StartsWith("export:"))
                {
                    var ext = action[7..];
                    try
                    {
                        var bytes = await Task.Run(() => ProjectFile.Export(S.Document, ext));
                        await DownloadAsync($"{FileBase()}.{ext}", bytes, ext == "png" ? "image/png" : "application/octet-stream");
                        Toast($"{S.T("Exported", "Diekspor")} {ext.ToUpperInvariant()} · {bytes.Length / 1024.0:N0} KB");
                    }
                    catch (Exception ex) { Toast($"{S.T("Export failed", "Ekspor gagal")}: {ex.Message}"); }
                }
                break;
        }
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private string FileBase() => string.Concat((S.Document.Name ?? "drawing").Select(c => char.IsLetterOrDigit(c) || c is '-' or '_' ? c : '-')).Trim('-');

    private async Task DownloadAsync(string name, byte[] bytes, string mime)
    {
        if (_canvas is not null) await _canvas.DownloadAsync(name, bytes, mime);
        else
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./studioCanvas.js");
            await module.InvokeVoidAsync("download", name, bytes, mime);
        }
    }

    private async Task OpenAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(256L * 1024 * 1024).CopyToAsync(ms);
            var doc = await Task.Run(() => ProjectFile.Open(e.File.Name, ms.ToArray()));
            S.Load(doc, e.File.Name);
            Toast($"{S.T("Opened", "Dibuka")} {e.File.Name}");
        }
        catch (Exception ex) { Toast($"{S.T("Could not open", "Tidak dapat membuka")} {e.File.Name}: {ex.Message}"); }
    }

    private async void Toast(string text)
    {
        _toastCts?.Cancel();
        var cts = _toastCts = new CancellationTokenSource();
        _toast = text; await InvokeAsync(StateHasChanged);
        try { await Task.Delay(3200, cts.Token); _toast = null; await InvokeAsync(StateHasChanged); } catch (TaskCanceledException) { }
    }

    public void Dispose() { S.Changed -= OnChanged; S.Engine.FileProduced -= OnFileProduced; _toastCts?.Cancel(); }
}
